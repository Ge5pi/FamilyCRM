# Backend API URL used by the Expo app.
#
# In development this file can be skipped: on a physical device the app
# derives http://<expo-host-ip>:8000 automatically (see frontend/api.js).
#
# Set EXPO_PUBLIC_API_URL explicitly for emulators, production builds and CI:
#   - Android emulator: http://10.0.2.2:8000
#   - Physical device:  http://<your-lan-ip>:8000
#   - Production:       https://api.your-domain.com
#
# Note: EXPO_PUBLIC_* variables are inlined at build time.
EXPO_PUBLIC_API_URL=
