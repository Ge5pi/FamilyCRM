# FamilyCRM backend configuration
# Copy this file to backend/.env and adjust the values.

# development | production
ENVIRONMENT=development

# --- Database -------------------------------------------------------------
# Local development (default): SQLite file next to the backend sources.
DATABASE_URL=sqlite:///./family_crm.db

# PostgreSQL (the target production database):
# DATABASE_URL=postgresql+psycopg2://familycrm:change-me@localhost:5432/familycrm

# --- Auth -----------------------------------------------------------------
# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=dev-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS -----------------------------------------------------------------
# Comma-separated list of allowed origins, or * for local development.
CORS_ORIGINS=*
